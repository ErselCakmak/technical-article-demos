<Window x:Class="WpfColorProfileSafeLoader.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Color Profile Safe Loader"
        Width="980"
        Height="650"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#07101C"
        Foreground="#F8FAFC">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="WPF COLOR PROFILE FALLBACK"
                       Foreground="#5EEAD4"
                       FontSize="14"
                       FontWeight="Bold" />
            <TextBlock Margin="0,12,0,0"
                       Text="Compare normal decoding with a narrow, observable fallback"
                       FontSize="27"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="#94A3B8"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Text="Choose a local PNG. On healthy systems both paths normally succeed; an affected ICC/display-profile combination can fail only on the normal path." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,24,0,20">
            <Button Width="132"
                    Height="38"
                    Click="ChooseImage_Click"
                    Content="Choose PNG" />
            <TextBlock x:Name="SelectedPathText"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#CBD5E1"
                       Text="No image selected"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="20" CornerRadius="18" Background="#0E1A2A" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="NORMAL BITMAPIMAGE" Foreground="#38BDF8" FontWeight="Bold" />
                    <Image x:Name="NormalImage" Grid.Row="1" Margin="0,16" Stretch="Uniform" />
                    <Button Grid.Row="2" Height="38" Click="LoadNormally_Click" Content="Load normally" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="20" CornerRadius="18" Background="#0E1A2A" BorderBrush="#5EEAD4" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="NORMAL-FIRST SAFE LOADER" Foreground="#5EEAD4" FontWeight="Bold" />
                    <Image x:Name="SafeImage" Grid.Row="1" Margin="0,16" Stretch="Uniform" />
                    <Button Grid.Row="2" Height="38" Click="LoadSafely_Click" Content="Load with fallback" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,20,0,0" Padding="14" CornerRadius="12" Background="#111D2E">
            <TextBlock x:Name="StatusText" Foreground="#CBD5E1" Text="Ready." TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
